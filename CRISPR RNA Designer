def calculate_gc(seq):
    gc_count = seq.count('G') + seq.count('C')
    return (gc_count / len(seq)) * 100


def off_target_risk(gRNA, dna):
    count = 0
    length = len(gRNA)

    for i in range(len(dna) - length + 1):
        sub = dna[i:i+length]
        mismatch = 0

        for j in range(length):
            if gRNA[j] != sub[j]:
                mismatch += 1
                if mismatch > 2:
                    break

        if mismatch <= 2:
            count += 1

    return count - 1  # exclude original match


def find_grna(dna):
    dna = dna.upper()
    results = []

    for i in range(len(dna) - 23):
        pam = dna[i+20:i+23]

        # Check NGG PAM
        if len(pam) == 3 and pam[1] == 'G' and pam[2] == 'G':
            grna = dna[i:i+20]

            gc = calculate_gc(grna)
            risk = off_target_risk(grna, dna)

            results.append({
                "gRNA": grna,
                "PAM": pam,
                "GC%": round(gc, 2),
                "Off-target risk": risk
            })

    return results


# ---- MAIN ----
if __name__ == "__main__":
    dna_input = input("Enter DNA sequence:\n").strip()

    candidates = find_grna(dna_input)

    print("\nPossible gRNA Candidates:\n")

    for c in candidates:
        print(f"gRNA: {c['gRNA']}")
        print(f"PAM: {c['PAM']}")
        print(f"GC Content: {c['GC%']}%")
        print(f"Off-target risk score: {c['Off-target risk']}")
        print("-" * 30)
